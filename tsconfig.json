{
  "compilerOptions": {
    // Node.js environment settings
    "lib": [
      "ES2023"
    ],
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Basic options
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Type definitions
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    // Output configuration: Bun runs the TypeScript sources directly, so the
    // compiler is only used for `tsc --noEmit` typechecking.
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
